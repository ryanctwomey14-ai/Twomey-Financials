{
  "name": "twomey-household-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Plaid integration server for the Twomey Household Wealth Console. Binds to 127.0.0.1 only.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "verify": "node verify.js",
    "seed": "node verify.js --seed",
    "test": "node test-normalize.js",
    "doctor": "node doctor.js",
    "digest:check": "node digest-cli.js check",
    "digest:send": "node digest-cli.js send"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "^10.0.2",
    "plaid": "^27.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
