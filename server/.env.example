# Copy this file to .env and fill in your own values.
# .env is gitignored. Never commit it, paste it into chat, or share a screenshot of it.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_client_id_here

# Plaid issues a DIFFERENT secret per environment. Use the one matching PLAID_ENV below.
PLAID_SECRET=your_secret_here

# sandbox    = Plaid's fake banks. Log in with user_good / pass_good. Free, instant.
# production = your real accounts. Requires approved production access on your Plaid account.
PLAID_ENV=sandbox

# Local server port.
PORT=4800

# Optional. 64 hex characters. If omitted, a key is generated at server/data/.key
# and used to encrypt your Plaid access tokens at rest.
# TWOMEY_KEY=
